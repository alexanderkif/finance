{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "angular-cli": {
      "type": "local",
      "command": ["npx", "-y", "@angular/cli", "mcp"],
      "enabled": true
    },
    "APIs.io": {
      "type": "remote",
      "url": "https://apis.io/mcp",
      "enabled": true
    },
    "finance-api": {
      "type": "local",
      "command": ["uv", "run", "--project", "api", "python", "api/mcp_dev.py"],
      "enabled": true
    }
  }
}
